# Ignore PyCharm settings
.idea/*
*.iml

# Ignore Python cache and build artifacts
__pycache__/
*.egg-info/
src/logs/*
*.pyc
.venv/*
.claude/

# Ignore large data files
*.pkl
*.mrc
*.mrcs
*.npy
*.log
data/**/*.png
!data/gallery/*.png

# SNR experiment outputs (simulated stacks, figures, runs)
data/snr_experiment/
